# 平时不用建这个文件：复制为 .env 后按需选择一个模型后端。
# .env 已在 .gitignore 里。
#
# 统一入口：auto / claude-sdk / codex / anthropic / openai
# auto 按 Claude Agent SDK（本机 Claude Code）→ Codex CLI → Anthropic key → OpenAI key 的顺序选。
# export V2T_PROVIDER=claude-sdk

# OpenAI GPT API
# export OPENAI_API_KEY=sk-...
# export OPENAI_MODEL=gpt-4o-mini
# export OPENAI_BASE_URL=https://api.openai.com/v1
# export V2T_IMAGE_DETAIL=high

# Codex CLI：使用本机已登录的 Codex，不需要把 API key 写进这个项目。
# export V2T_PROVIDER=codex
# export CODEX_MODEL=gpt-5-codex
# export V2T_CODEX_BIN=codex
# export V2T_CODEX_TIMEOUT=900

# Anthropic API（兼容旧配置）
# export ANTHROPIC_API_KEY=sk-ant-...
# export ANTHROPIC_BASE_URL=https://api.anthropic.com

# 也可以用 V2T_MODEL 统一覆盖上面的模型选择。
# export V2T_MODEL=gpt-4o-mini
# export V2T_LANG=en
# export V2T_DOC_LANG=中文
