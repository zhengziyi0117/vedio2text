# 平时不用建这个文件：脚本会自动认环境里已有的 ANTHROPIC_API_KEY 或
# ANTHROPIC_AUTH_TOKEN（含 ANTHROPIC_BASE_URL，走自建网关就靠它）。
# 两个都没有时才会回退到 Claude Agent SDK（底层是本机 Claude Code）。
# 只有想覆盖默认值时才 cp 成 .env 填。.env 已在 .gitignore 里。
#
# export ANTHROPIC_API_KEY=sk-ant-...

# 模型默认跟随 ANTHROPIC_MODEL，一般不用设
# export V2T_MODEL=claude-opus-5
# export V2T_LANG=en
# export V2T_DOC_LANG=中文
